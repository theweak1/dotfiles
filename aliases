system-updater() {
  sudo apt-get update &&
  sudo apt-get upgrade -y &&
  sudo apt-get clean -y &&
  sudo apt-get autoclean -y &&
  sudo apt-get autoremove -y --purge

  # Check if 'snap' is a valid command and if so, run 'snap refresh'
  if command -v snap >/dev/null 2>&1; then
    sudo snap refresh
  fi
}

mkcd() {
  mkdir -p "$@" && cd "$_"
}

